# Settings for the API when you press F5 in VS Code. Copy to .env.api (never commit it).
# The three passwords MUST match the ones in your .env file used by docker compose.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:8080
ConnectionStrings__Postgres=Host=localhost;Database=sentinelpay;Username=sentinel;Password=SAME_AS_PG_PASSWORD
ConnectionStrings__Redis=localhost:6379,password=SAME_AS_REDIS_PASSWORD
Messaging__Provider=RabbitMq
Messaging__RabbitMq__Host=localhost
Messaging__RabbitMq__User=sentinel
Messaging__RabbitMq__Password=SAME_AS_RABBIT_PASSWORD
Jwt__SigningKey=any-long-random-text-at-least-32-characters-long
# Try other risk modes by changing this and restarting: Off, Sync, Async, Hybrid
Risk__Mode=Hybrid
