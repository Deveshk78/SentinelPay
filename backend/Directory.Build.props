<Project><PropertyGroup>
<TargetFramework>net9.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
<!-- First builds: warnings do not fail the build. Once green, run CI with -p:StrictWarnings=true and fix what appears. -->
<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
</PropertyGroup>
<PropertyGroup Condition="'$(StrictWarnings)'=='true'"><TreatWarningsAsErrors>true</TreatWarningsAsErrors><AnalysisLevel>latest-recommended</AnalysisLevel></PropertyGroup></Project>
