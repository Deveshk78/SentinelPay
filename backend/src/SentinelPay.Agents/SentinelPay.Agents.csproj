<Project Sdk="Microsoft.NET.Sdk">
  <!-- Two flavours, so a preview-API break in the Agent Framework can never block the rest of the suite:
       default build       -> plain IChatClient (Microsoft.Extensions.AI), agents run in parallel with Task.WhenAll
       -p:UseMaf=true      -> Microsoft Agent Framework workflow graph (set USE_MAF) -->
  <PropertyGroup><UseMaf Condition="'$(UseMaf)'==''">false</UseMaf></PropertyGroup>
  <PropertyGroup Condition="'$(UseMaf)'=='true'"><DefineConstants>$(DefineConstants);USE_MAF</DefineConstants></PropertyGroup>
  <ItemGroup><ProjectReference Include="..\SentinelPay.Application\SentinelPay.Application.csproj"/></ItemGroup>
  <ItemGroup><PackageReference Include="Microsoft.Extensions.AI"/></ItemGroup>
  <ItemGroup Condition="'$(UseMaf)'=='true'">
    <PackageReference Include="Microsoft.Agents.AI"/>
    <PackageReference Include="Microsoft.Agents.AI.Workflows"/>
  </ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="SentinelPay.Agents.Tests"/></ItemGroup>
</Project>
